# ⚠️ 這是範本，複製為 .env 並填入實際值
# ⚠️ .env 已加入 .gitignore，絕對不要提交到 git

# ── 環境識別 ────────────────────────────────────────────────────
APP_ENV=development       # development | staging | production

# ── 應用程式 ────────────────────────────────────────────────────
APP_PORT=8000
APP_SECRET_KEY=           # 正式環境請使用隨機長字串（可請 AI 生成）

# ── 資料庫（若有）──────────────────────────────────────────────
# DATABASE_URL=           # 範例：postgresql://user:pass@localhost:5432/mydb

# ── 外部服務 API 金鑰（若有）────────────────────────────────────
# 每個外部服務一行，例如：
# OPENAI_API_KEY=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
