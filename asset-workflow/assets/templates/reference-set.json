{
  "work": "<作品>",
  "store": "<參考庫位置，由專案宣告>",
  "artBible": "<符合的 art bible 版本>",
  "approvedAt": "<ART-0 核可日期>",
  "approval": "<進度紀錄的任務代號與那一列的時間，不指向會被清掉的暫存；原話要寫進這裡先取得人類同意>",
  "classes": [
    {
      "id": "<畫面類別，例如 oblique-far>",
      "description": "<鏡頭幾何或段落性質>",
      "sections": ["<作品中屬於這一類的段落>"],
      "workWindows": ["<作品要看的畫面或時段，評分與並排以這些為準>"],
      "rhythm": ["<選填：會隨時間變化的事件與節奏數字，例如燃燒 8～12 秒、每 0.5 秒消失不超過 8%>"],
      "structureChecks": ["<選填：真實物件的結構檢查項，例如艙段方向、引擎數量、顏色>"]
    }
  ],
  "references": [
    {
      "file": "<作品>/<參考集>/<檔名>（參考庫內的路徑）",
      "source": "<來源網址或出處>",
      "license": "<授權名稱與條件>",
      "retrievedAt": "<取得日期>",
      "bytes": 0,
      "sha256": "<檔案雜湊>",
      "class": "<對應的畫面類別>",
      "window": { "start": "<分析起點>", "end": "<分析終點>" },
      "measureBox": { "x": 0.0, "y": 0.0, "width": 1.0, "height": 1.0 },
      "conditions": "<光線、時段、鏡頭角度等，和作品的差異>"
    }
  ],
  "metrics": [
    {
      "id": "<指標代號>",
      "description": "<量什麼、怎麼量>",
      "class": "<套用的畫面類別>",
      "target": { "min": 0.0, "max": 1.0 },
      "mode": "judge"
    }
  ],
  "subjective": {
    "items": ["<主觀評分項目>"],
    "scale": "1-5",
    "threshold": "<ART-0 核可的門檻>"
  },
  "excluded": [
    { "section": "<不比的段落或指標>", "reason": "<理由，例如刻意風格化、試量分不出缺陷>" }
  ],
  "noiseFloor": { "method": "<同一份程式渲染兩次的比對方式>", "value": "<量到的差異>" },
  "ruleChanges": [
    {
      "metric": "<指標代號>",
      "before": "<原規則>",
      "after": "<修正後規則>",
      "reason": "<理由>",
      "status": "pending"
    }
  ]
}
