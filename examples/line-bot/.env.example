# ⚠️ 這是範本，複製為 .env 並填入實際值
# ⚠️ .env 已加入 .gitignore，絕對不要提交到 git

# ── 環境識別 ────────────────────────────────────────────────────
APP_ENV=development       # development | staging | production

# ── 應用程式 ────────────────────────────────────────────────────
APP_PORT=8000

# ── LINE Messaging API ───────────────────────────────────────────
# 在 LINE Developers Console 取得（https://developers.line.biz/）
LINE_CHANNEL_SECRET=      # Channel Secret（驗證 webhook 請求用）
LINE_CHANNEL_ACCESS_TOKEN=  # Channel Access Token（發送訊息用）
